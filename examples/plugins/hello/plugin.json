{
  "id": "hello.demo",
  "name": "Hello",
  "version": "0.1.0",
  "api": 2,
  "entry": "main.js",
  "description": "Drop-in demo plugin: storage, settings form, broadcast and both stream codecs.",
  "contributes": {
    "views": [
      {
        "slot": "tool",
        "id": "hello",
        "title": "Hello",
        "icon": "👋"
      }
    ],
    "settings": [
      {
        "key": "greeting",
        "label": "Greeting",
        "type": "text",
        "default": "Hello"
      },
      {
        "key": "loud",
        "label": "Shout it",
        "type": "boolean",
        "default": false
      },
      {
        "key": "intervalMs",
        "label": "Ticker interval (ms)",
        "type": "number",
        "default": 400,
        "min": 50,
        "max": 5000
      }
    ],
    "theme": {
      "dark": {
        "--color-brand": "#a78bfa",
        "--color-brand-hover": "#bda4ff"
      },
      "light": {
        "--color-brand": "#6d3fc4",
        "--color-brand-hover": "#5c33ac"
      }
    }
  },
  "permissions": [
    "rpc:storage",
    "rpc:bus",
    "rpc:stream",
    "rpc:host"
  ]
}
